rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() ? getUserData().role : '';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'Admin');
    }

    function isManager() {
      return isAuthenticated() && (getUserRole() == 'Admin' || getUserRole() == 'Inventory Manager');
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserRole() == 'Admin' || 
        getUserRole() == 'Inventory Manager' || 
        getUserRole() == 'Warehouse Staff'
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // 2. Categories
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // 3. Warehouses
    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 4. Locations
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // 5. Products catalog
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // 6. Stock Balances
    match /stockBalances/{balanceId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // 7. Receipts
    match /receipts/{receiptId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // 8. Deliveries
    match /deliveries/{deliveryId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // 9. Transfers
    match /transfers/{transferId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // 10. Adjustments
    match /adjustments/{adjustmentId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // 11. Stock Ledger (STRICTLY IMMUTABLE AUDIT TRAIL)
    // Records can ONLY be appended. Modifications and deletions are strictly forbidden!
    match /stockLedger/{ledgerId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // 12. Document sequence counters
    match /counters/{counterId} {
      allow read, write: if isStaff();
    }

    // 13. System Notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // 14. Company Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
