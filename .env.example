# Firebase Configuration
# Replace these values with your actual Firebase project settings from Firebase Console:
# Project Settings > General > Your apps > Web app > SDK setup and configuration

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Demo & Offline Mode
# Set to 'false' to enforce strictly live Firebase; 'true' or leaving API key placeholder enables offline demo storage fallback
VITE_DEMO_MODE=true
